# ---------------------------------------------------------------------------
# NoteKoi web environment template.
# Copy to apps/web/.env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Prefix the browser uses. Keep it relative so every call goes through the
# Next.js proxy below (same origin => the httpOnly cookie works everywhere).
NEXT_PUBLIC_API_URL=/api/v1

# Where the Next.js server forwards /api/* (the Express API).
API_PROXY_TARGET=http://localhost:5000
